# Server
PORT=3004
NODE_ENV=development

# Database
# DB_PROVIDER=sqlite   (default)
# DB_PROVIDER=postgres
# SQLITE_PATH=backend/inachis.db
# DATABASE_URL=postgresql://user:pass@host/db

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-before-deploying

# Email delivery (contact form) — via Resend HTTPS API
# Required for the contact form to actually send messages (Railway Free/Hobby
# blocks outbound SMTP, so an HTTPS transactional API is used).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx     (Resend API key — secret)
# EMAIL_FROM=Kateřina Inachis <onboarding@resend.dev>
# CONTACT_EMAIL=your-contact@example.com     (optional: overrides the admin
#                                            "contact_email" setting as recipient)

# Service name for logs
SERVICE_NAME=inachis
